# Copy to .env — never commit the real file.

# --- Database (wslc-compose) ---
POSTGRES_USER=devsync
POSTGRES_PASSWORD=devsync
POSTGRES_DB=devsync
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devsync:devsync@localhost:5432/devsync

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# --- Realtime multi-node (optional) ---
# When set, domain events are published on Redis channel `devsync:events`.
# Without it, EventBus stays in-process (single API node).
# REDIS_URL=redis://127.0.0.1:6379

# --- Attachments ---
# ATTACHMENTS_DIR=.data/attachments
# ATTACHMENTS_MAX_BYTES=10485760

# --- Email (Resend) ---
# Optional. When unset, invitation create returns emailDelivery: "skipped" and shows the link only.
# Shared test domain: DevSync <onboarding@resend.dev> (Resend account limits may apply).
# RESEND_API_KEY=
MAIL_FROM=DevSync <onboarding@resend.dev>

# --- MCP server ---
DEVSYNC_API_URL=http://localhost:3000
DEVSYNC_API_TOKEN=

# --- Stack applicative (wslc-compose : api + web ; laisse `db` de dev intact) ---
# STACK_DB=devsync_stack
# API_PORT=3100
# WEB_PORT=8080
# WEB_ORIGIN=http://localhost:8080
# COOKIE_SECURE=true

# --- Vercel (web SPA) ---
# When the frontend is on Vercel, point the API at that origin and enable secure cookies:
# WEB_ORIGIN=https://your-app.vercel.app
# COOKIE_SECURE=true
# In vercel.json, replace API_HOST_PLACEHOLDER with the public API host (no scheme path).
# WebSocket realtime through Vercel → external API is limited; prefer API + web behind one domain later.

